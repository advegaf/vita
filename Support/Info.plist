<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ANTHROPIC_API_KEY</key>
	<string>$(ANTHROPIC_API_KEY)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Vita</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Vita uses the camera so you can photograph a lab report to read its values. Educational only.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>vita reads your recent sleep, HRV, heart rate, weight, and steps to ground its educational suggestions. Read-only, and you can skip it.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Vita does not write any data to Apple Health. This permission is required by the HealthKit capability; all access is read-only.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Vita reads a lab-report photo you choose to extract its values. Educational only.</string>
	<key>OURA_CLIENT_ID</key>
	<string>$(OURA_CLIENT_ID)</string>
	<key>OURA_CLIENT_SECRET</key>
	<string>$(OURA_CLIENT_SECRET)</string>
	<key>UIAppFonts</key>
	<array>
		<string>InterTight.ttf</string>
		<string>InterTight-Bold.ttf</string>
		<string>InterTight-Black.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
