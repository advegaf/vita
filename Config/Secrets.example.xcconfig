// Template for Config/Secrets.xcconfig (which is gitignored — never commit it).
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
// then fill in the values below.

// Your Anthropic API key (https://console.anthropic.com → API keys).
// OPTIONAL: the app runs without it via the rule-based fallback / VITA_CLAUDE_STUB=1;
// AI features (protocol generation, chat, lab reading) need a real key.
ANTHROPIC_API_KEY =

// Your Apple Developer Team ID (Xcode → Settings → Accounts, or developer.apple.com).
// Required to build/sign for a physical device; not needed for the simulator.
DEVELOPMENT_TEAM =
